NODE_ENV=production
PORT=3888
CONTROL_PLANE_PUBLIC_URL=https://xensemble.dev

# PostgreSQL (PlanetScale: port 6432 via PgBouncer, DATABASE_SSL=true)
DATABASE_URL=postgres://user:password@host:6432/database
DATABASE_SSL=true

# Required: at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Required: 64-character hex string (32 bytes)
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# CORS origins for the web admin UI; adjust to your Desktop Client / web admin URL
ALLOWED_ORIGINS=https://xensemble.dev

# Comma-separated list of trusted proxy IPs; leave empty to disable trustProxy
TRUSTED_PROXIES=

# Local execution workspace root (host path; mapped into blink via virtiofs when boxlite)
WORKSPACE_ROOT=/var/lib/xensemble/workspaces

# Execution plane: local | boxlite (default) | k8s
RUNTIME_PROVIDER=boxlite
BLINK_API_URL=http://127.0.0.1:8787
# Install blink-server: ./deploy/install-blink-server.sh v0.3.5
# Build agent sandbox images: npm run build:agent-images
# Push to your registry, then register active versions in Admin → Images.
# XENSEMBLE_AGENT_IMAGE_REGISTRY=ghcr.io/yourorg
# XENSEMBLE_AGENT_IMAGE_TAG=latest
# BLINK_BASE_IMAGE=ghcr.io/yourorg/box-base:bookworm
# Local dev registry example:
# XENSEMBLE_AGENT_IMAGE_REGISTRY=localhost:5000/xensemble
# BLINK_BASE_IMAGE=localhost:5000/xensemble/box-base:bookworm
# blink-server must trust HTTP registry — see deploy/blink.env.example
# Guest workspace path inside blink sessions (default /workspace)
# WORKSPACE_PATH=/workspace

# LLM for one-click deploy analysis, commit/PR message generation,
# and auto-generating session titles (OpenAI-compatible chat completions endpoint)
LLM_ANALYZE_API_URL=
LLM_ANALYZE_API_KEY=
LLM_ANALYZE_MODEL=

# UniGateway (LLM proxy)
UNIGATEWAY_BIND_ADDR=127.0.0.1:8741
UNIGATEWAY_ADMIN_TOKEN=change-me-to-a-long-random-admin-token
UNIGATEWAY_LOG=info

# Optional process isolation (numeric uid/gid). Applies to both Agent and Preview processes.
RUNTIME_UID=
RUNTIME_GID=

# Local Process Runtime resource limits.
# Set RUNTIME_USE_SYSTEMD=1 to apply limits via systemd-run --scope (cgroups-v2).
# Otherwise limits fall back to prlimit/nice. CPU, memory and task limits only
# work in systemd mode; in fallback mode memoryMaxMb and maxProcesses are
# ignored because prlimit --as/--nproc break Node/WebAssembly agents.
RUNTIME_USE_SYSTEMD=0
RUNTIME_CPU_PERCENT=80
RUNTIME_MEMORY_MAX_MB=
RUNTIME_MAX_PROCESSES=64
RUNTIME_NICE=10

# LLM_VERIFY_MODEL overrides the model used by the stage-2 verify agent
# (defaults to LLM_ANALYZE_MODEL)
LLM_VERIFY_MODEL=
