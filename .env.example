# Database (PostgreSQL 16+)
DATABASE_URL=postgres://xensemble:xensemble@127.0.0.1:5432/xensemble
# 本地 Docker 无需 TLS；PlanetScale 等托管库设为 true
DATABASE_SSL=false

# Server
PORT=3888
CONTROL_PLANE_PUBLIC_URL=http://127.0.0.1:3888
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string
ALLOWED_ORIGINS=http://127.0.0.1:3889,http://localhost:3889
TRUSTED_PROXIES=
WORKSPACE_ROOT=./server/data/workspaces

# Local Process Runtime resource limits
RUNTIME_USE_SYSTEMD=0
RUNTIME_CPU_PERCENT=80
RUNTIME_MEMORY_MAX_MB=2048
RUNTIME_MAX_PROCESSES=64
RUNTIME_NICE=10

# Gateway
UNIGATEWAY_BIND_ADDR=127.0.0.1:8741
UNIGATEWAY_ADMIN_TOKEN=change-me-to-a-long-random-admin-token
UNIGATEWAY_LOG=info

# LLM 原始请求采集（TEMPORARY 临时诊断：落盘各 agent 组装后的完整请求体，
# 供提示词组装分析；网关消息处理功能上线后整体移除。默认已开启（all），
# 磁盘由总量配额 + 保留期 + 单请求上限兜底；设 LLM_CAPTURE_MODE=off 关闭。
# 本地开发若 /var/lib 不可写，采集自动失效（限流报错），可显式指定可写目录。
LLM_CAPTURE_MODE=all                   # off|first|turns|all：off=关闭；first=每会话第 1 个；turns=每会话前 N 个；all=全量
# LLM_CAPTURE_TURNS=3                  # turns 模式：每会话采集前 N 个请求
# LLM_CAPTURE_DIR=/var/lib/xensemble/llm-capture   # 本地开发可设 ./server/data/llm-capture
# LLM_CAPTURE_MAX_BYTES=8388608        # 单请求原始 body 上限，超限写 oversize 元数据桩
# LLM_CAPTURE_MAX_TOTAL_MB=2048        # 总量配额，超限从最旧日期目录删除（当天目录不删）
# LLM_CAPTURE_RETENTION_DAYS=7         # 保留期（天），启动时与定时清理过期日期目录

# LLM 分析（会话标题 / 对话摘要 / 部署分析共用，OpenAI 兼容 chat completions 端点）
# LLM_ANALYZE_API_KEY=sk-xxx
# LLM_ANALYZE_API_URL=https://api.deepseek.com/chat/completions
# LLM_ANALYZE_MODEL=deepseek-chat
# LLM_ANALYZE_TIMEOUT_MS=60000

# Scheduler（P2 定时摘要，进程内 + PG 乐观锁）
# SCHEDULER_ENABLED=true
# SCHEDULER_LOCK_TIMEOUT_MS=600000
# CONVERSATION_SUMMARY_INTERVAL_MS=300000
# CONVERSATION_SUMMARY_BATCH=5

# Skills（P3 技能提炼漏斗）
# SKILL_EXTRACT_ENABLED=false            # 灰度开关：false 时 exit 入池与 skill-pipeline job 均 no-op（零 LLM 调用）
# SKILL_PIPELINE_INTERVAL_MS=21600000    # 漏斗 job 间隔（默认 6h）
# SKILL_CANDIDATE_MIN_SCORE=40           # L1 入池阈值
# SKILL_SINGLETON_MIN_SCORE=60           # 单例候选升级阈值
# SKILL_CANDIDATE_TTL_DAYS=7             # 活跃候选 7 天未升级 → expired
# SKILL_DRAFT_TTL_DAYS=30                # auto draft 30 天未处理 → 删除（manual 永久保留）

# Skills（P4 注入：active skill 渲染进 workspace 指令文件 AGENTS.md/CLAUDE.md）
# SKILL_INJECT_ENABLED=false             # 灰度开关：false 时 spawn 前不注入、状态变更不重渲染（零影响）
# SKILL_INJECT_MAX_COUNT=10              # 注入条数上限（超限截断并记审计）
# SKILL_INJECT_MAX_BYTES=8192            # 注入段字节上限（超限截断并记审计）
